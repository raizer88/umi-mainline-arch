# Experimental: QCOM EPSS/CPR CPU frequency scaling (SM8250 / umi).
#
# The default config deliberately keeps these off during bring-up. Enable with:
#   EXTRA_CONFIG=config/umi-cpufreq.config ALLOW_CPUFREQ=1 sh scripts/build.sh
#
# QCOM_CPR also drives the CPU voltage table (as Android does). Keep a known-good
# boot image ready; this can hang or reset the device at the wrong OPP.
CONFIG_QCOM_CPR=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
# CONFIG_ARM_QCOM_CPUFREQ_NVMEM is not set
